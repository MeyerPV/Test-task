{
  "name": "firebird-posts",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fsd": "steiger ./src --fail-on-warnings",
    "format:check": "prettier --check .",
    "check:deps": "node scripts/check-deps.mjs",
    "verify": "npm run typecheck && npm run lint && npm run lint:fsd && npm run format:check && npm run check:deps",
    "pods": "node scripts/install-pods.mjs --force",
    "postinstall": "node scripts/install-pods.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,ts,tsx}": "eslint --max-warnings=0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@reduxjs/toolkit": "^2.13.0",
    "clsx": "^2.1.1",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-mmkv": "~4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "~4.29.0",
    "react-native-worklets": "^0.13.0",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/react": "^19.2.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "eslint-plugin-local-rules": "^3.0.2",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "2.8.8",
    "steiger": "^0.7.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^22.22.1 || ^24.3.0",
    "npm": ">=10"
  }
}
